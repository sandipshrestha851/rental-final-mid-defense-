<file path="next-frontend/src/hooks/useAuth.ts">
"use client";

import { useCallback, useEffect, useState } from "react";
import type { AuthUser, LoginResponse } from "@/lib/types";

const TOKEN_KEY = "token";
const USER_KEY = "user";

interface AuthState {
  token: string | null;
  user: AuthUser | null;
  ready: boolean; // becomes true once we've read localStorage on the client
}

/**
 * Reads the persisted auth session from localStorage and exposes
 * login / logout helpers. `ready` guards against SSR hydration flashes.
 */
export function useAuth() {
  const [state, setState] = useState<AuthState>({
    token: null,
    user: null,
    ready: false,
  });

  useEffect(() => {
    try {
      const token = localStorage.getItem(TOKEN_KEY);
      const rawUser = localStorage.getItem(USER_KEY);
      const user = rawUser ? (JSON.parse(rawUser) as AuthUser) : null;
      setState({ token, user, ready: true });
    } catch {
      setState({ token: null, user: null, ready: true });
    }
  }, []);

  const login = useCallback((data: LoginResponse) => {
    localStorage.setItem(TOKEN_KEY, data.token);
    localStorage.setItem(USER_KEY, JSON.stringify(data.user));
    setState({ token: data.token, user: data.user, ready: true });
  }, []);

  const logout = useCallback(() => {
    localStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(USER_KEY);
    setState({ token: null, user: null, ready: true });
  }, []);

  return { ...state, login, logout };
}
</file>

<file path="next-frontend/src/hooks/useChatSocket.ts">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import { io, Socket } from "socket.io-client";
import { API_URL } from "@/lib/api";
import type { Message } from "@/lib/types";

interface UseChatSocketArgs {
  token: string | null;
  /** Called when a user's online status changes. */
  onStatusChange: (userId: number, online: boolean) => void;
}

/**
 * Owns the socket.io lifecycle: connection, incoming messages,
 * presence updates and typing relays. Exposes imperative senders.
 */
export function useChatSocket({ token, onStatusChange }: UseChatSocketArgs) {
  const socketRef = useRef<Socket | null>(null);
  const typingTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const [connected, setConnected] = useState(false);
  const [messages, setMessages] = useState<Message[]>([]);
  const [typingUserId, setTypingUserId] = useState<number | null>(null);

  // Keep the latest status callback without re-subscribing the socket.
  const statusRef = useRef(onStatusChange);
  statusRef.current = onStatusChange;

  useEffect(() => {
    if (!token) return;

    const socket = io(API_URL, {
      auth: { token },
      transports: ["websocket", "polling"],
    });

    socket.on("connect", () => setConnected(true));
    socket.on("disconnect", () => setConnected(false));

    socket.on("new_message", (msg: Message) => {
      setMessages((prev) =>
        prev.some((m) => m.id === msg.id) ? prev : [...prev, msg]
      );
    });

    socket.on(
      "user_status",
      (data: { user_id: number; status: string }) => {
        statusRef.current(data.user_id, data.status === "online");
      }
    );

    socket.on(
      "user_typing",
      (data: { sender_id: number; is_typing: boolean }) => {
        setTypingUserId((prev) =>
          data.is_typing
            ? data.sender_id
            : prev === data.sender_id
            ? null
            : prev
        );
      }
    );

    socketRef.current = socket;
    return () => {
      socket.disconnect();
      socketRef.current = null;
    };
  }, [token]);

  const sendMessage = useCallback(
    (receiverId: number, text: string) => {
      const trimmed = text.trim();
      if (!trimmed || !token || !socketRef.current) return;
      socketRef.current.emit("send_message", {
        token,
        receiver_id: receiverId,
        message: trimmed,
      });
      socketRef.current.emit("typing", {
        token,
        receiver_id: receiverId,
        is_typing: false,
      });
    },
    [token]
  );

  const notifyTyping = useCallback(
    (receiverId: number) => {
      if (!token || !socketRef.current) return;
      socketRef.current.emit("typing", {
        token,
        receiver_id: receiverId,
        is_typing: true,
      });
      if (typingTimeoutRef.current) clearTimeout(typingTimeoutRef.current);
      typingTimeoutRef.current = setTimeout(() => {
        socketRef.current?.emit("typing", {
          token,
          receiver_id: receiverId,
          is_typing: false,
        });
      }, 2000);
    },
    [token]
  );

  return {
    connected,
    messages,
    setMessages,
    typingUserId,
    sendMessage,
    notifyTyping,
    disconnect: () => socketRef.current?.disconnect(),
  };
}
</file>

<file path="next-frontend/src/lib/api.ts">
// Thin, typed wrapper around the backend REST API.
// Keeps all fetch logic + error handling in one place so components stay clean.

import type {
  LoginPayload,
  LoginResponse,
  Message,
  RegisterPayload,
  User,
} from "./types";

export const API_URL =
  process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

/** Error thrown when the API responds with a non-2xx status. */
export class ApiError extends Error {
  status: number;
  constructor(message: string, status: number) {
    super(message);
    this.name = "ApiError";
    this.status = status;
  }
}

/** Core request helper: sends JSON, parses JSON, throws ApiError on failure. */
async function request<T>(
  path: string,
  options: RequestInit = {}
): Promise<T> {
  const res = await fetch(`${API_URL}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(options.headers || {}),
    },
  });

  // Some endpoints (or errors) may not return JSON — guard against that.
  let data: unknown = null;
  const text = await res.text();
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      data = { message: text };
    }
  }

  if (!res.ok) {
    const message =
      (data as { message?: string })?.message ||
      `Request failed with status ${res.status}`;
    throw new ApiError(message, res.status);
  }

  return data as T;
}

/** Attach the Bearer token header for authenticated requests. */
function authHeaders(token: string): HeadersInit {
  return { Authorization: `Bearer ${token}` };
}

export const api = {
  register(payload: RegisterPayload): Promise<{ message: string }> {
    return request("/api/register", {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },

  login(payload: LoginPayload): Promise<LoginResponse> {
    return request<LoginResponse>("/api/login", {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },

  getUsers(token: string): Promise<User[]> {
    return request<User[]>("/api/users", {
      headers: authHeaders(token),
    });
  },

  getMessages(token: string, otherUserId: number): Promise<Message[]> {
    return request<Message[]>(`/api/messages/${otherUserId}`, {
      headers: authHeaders(token),
    });
  },
};
</file>

<file path="next-frontend/src/lib/types.ts">
// Shared domain types used across the chat + auth feature.

/** A user as returned by the backend (safe fields only, no password). */
export interface User {
  id: number;
  full_name: string;
  email: string;
  phone?: string | null;
  gender?: string | null;
  date_of_birth?: string | null;
  bio?: string | null;
  is_online?: boolean;
  created_at?: string | null;
}

/** The minimal user object stored in localStorage after login. */
export interface AuthUser {
  id: number;
  full_name: string;
  email: string;
  role?: string | null;
}

/** A single chat message between two users. */
export interface Message {
  id: number;
  sender_id: number;
  receiver_id: number;
  message: string;
  created_at: string;
}

/** Payload sent to POST /api/register. Only name/email/password are required. */
export interface RegisterPayload {
  full_name: string;
  email: string;
  password: string;
  phone?: string;
  gender?: string;
  date_of_birth?: string;
  bio?: string;
  role?: string;
}

/** Payload sent to POST /api/login. */
export interface LoginPayload {
  email: string;
  password: string;
}

/** Response returned by POST /api/login. */
export interface LoginResponse {
  token: string;
  user: AuthUser;
}
