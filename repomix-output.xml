# node-backend

Node.js + Express + Socket.IO + MySQL backend for the chat system.

## Run

```bash
npm install
npm start        # or: npm run dev  (nodemon)
```

Requires MySQL running (XAMPP) and a database named `room_rental` (see `.env`).
Tables are created automatically on first start.

## Files

- `server.js` — Express REST endpoints + Socket.IO handlers + startup
- `db.js` — MySQL connection pool (`mysql2`) and schema initialization
- `.env` — configuration (copy of `.env.example`)

## Stack

- `express` — HTTP server / REST
- `socket.io` — real-time messaging
- `mysql2` — MySQL driver (connection pool, prepared statements)
- `jsonwebtoken` — JWT auth
- `bcryptjs` — password hashing
- `cors`, `dotenv`
</file>

<file path="node-backend/server.js">
// server.js
// Node.js + Express + Socket.IO backend for the real-time chat system.

require("dotenv").config();

const http = require("http");
const express = require("express");
const cors = require("cors");
const jwt = require("jsonwebtoken");
const bcrypt = require("bcryptjs");
const { Server } = require("socket.io");

const { pool, initDb } = require("./db");

const JWT_SECRET = process.env.JWT_SECRET || "super-secret-key";
const PORT = parseInt(process.env.PORT || "8000", 10);

const app = express();
app.use(cors({ origin: "*" }));
app.use(express.json());

const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: "*" },
});

// ---------------------------------------------------------------------------
// In-memory online-user tracking.
// Maps user_id (number) -> Set of socket ids (string).
// ---------------------------------------------------------------------------
const onlineUsers = new Map();

function addOnline(userId, socketId) {
  if (!onlineUsers.has(userId)) onlineUsers.set(userId, new Set());
  onlineUsers.get(userId).add(socketId);
}

function removeOnline(socketId) {
  for (const [userId, sids] of onlineUsers.entries()) {
    if (sids.has(socketId)) {
      sids.delete(socketId);
      const wentOffline = sids.size === 0;
      if (wentOffline) onlineUsers.delete(userId);
      return { userId, wentOffline };
    }
  }
  return null;
}

function isOnline(userId) {
  return onlineUsers.has(userId) && onlineUsers.get(userId).size > 0;
}

// ---------------------------------------------------------------------------
// JWT helpers
// ---------------------------------------------------------------------------
function signToken(user) {
  return jwt.sign(
    {
      user_id: user.id,
      email: user.email,
      full_name: user.full_name,
      role: user.role,
    },
    JWT_SECRET,
    { expiresIn: "24h" }
  );
}

// Express middleware: require a valid Bearer token.
function tokenRequired(req, res, next) {
  const authHeader = req.headers["authorization"] || "";
  let token = null;
  if (authHeader.startsWith("Bearer ")) {
    token = authHeader.split(" ")[1];
  }
  if (!token) {
    return res.status(401).json({ message: "Token is missing" });
  }
  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    req.userId = decoded.user_id;
    req.email = decoded.email;
    next();
  } catch (err) {
    if (err.name === "TokenExpiredError") {
      return res.status(401).json({ message: "Token has expired" });
    }
    return res.status(401).json({ message: "Token is invalid" });
  }
}

// Decode a token from a socket handshake (auth object or query string).
function verifySocketToken(socket) {
  let token =
    (socket.handshake.auth && socket.handshake.auth.token) ||
    (socket.handshake.query && socket.handshake.query.token) ||
    null;
  if (!token) return null;
  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    return decoded.user_id;
  } catch (err) {
    return null;
  }
}

// Normalize an empty string to NULL so optional columns stay clean.
function orNull(value) {
  if (value === undefined || value === null) return null;
  const str = String(value).trim();
  return str.length ? str : null;
}

// ---------------------------------------------------------------------------
// REST ENDPOINTS
// ---------------------------------------------------------------------------

app.get("/", (req, res) => {
  res.json({ status: "ok", message: "Chat backend (Node.js) is running" });
});

// Register — collects the full profile and stores it as-is.
// The only structural requirements are email + password (needed for login).
// Password/confirm matching is validated on the client.
app.post("/api/register", async (req, res) => {
  const data = req.body || {};

  const full_name = orNull(data.full_name);
  const email = data.email ? String(data.email).trim().toLowerCase() : "";
  const password = data.password ? String(data.password) : "";
  const phone = orNull(data.phone);
  const gender = orNull(data.gender);
  const date_of_birth = orNull(data.date_of_birth);
  const bio = orNull(data.bio);
  const role = orNull(data.role);

  if (!email || !password) {
    return res.status(400).json({ message: "Email and password are required" });
  }

  try {
    const [existing] = await pool.query(
      "SELECT id FROM users WHERE email = ?",
      [email]
    );
    if (existing.length > 0) {
      return res.status(409).json({ message: "Email already registered" });
    }

    const hashedPw = await bcrypt.hash(password, 10);
    await pool.query(
      `INSERT INTO users
        (full_name, email, phone, gender, date_of_birth, bio, role, password_hash)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      [full_name, email, phone, gender, date_of_birth, bio, role, hashedPw]
    );

    return res.status(201).json({ message: "User registered successfully" });
  } catch (err) {
    return res.status(500).json({ message: `Server error: ${err.message}` });
  }
});

// Login — authenticate with email + password.
app.post("/api/login", async (req, res) => {
  const data = req.body || {};
  const email = data.email ? String(data.email).trim().toLowerCase() : "";
  const password = data.password ? String(data.password) : "";

  if (!email || !password) {
    return res.status(400).json({ message: "Missing email or password" });
  }

  try {
    const [rows] = await pool.query("SELECT * FROM users WHERE email = ?", [
      email,
    ]);
    const user = rows[0];

    if (!user || !(await bcrypt.compare(password, user.password_hash))) {
      return res.status(401).json({ message: "Invalid credentials" });
    }

    const token = signToken(user);
    return res.status(200).json({
      token,
      user: {
        id: user.id,
        full_name: user.full_name,
        email: user.email,
        role: user.role,
      },
    });
  } catch (err) {
    return res.status(500).json({ message: `Server error: ${err.message}` });
  }
});

// List all users (except current), with online status.
app.get("/api/users", tokenRequired, async (req, res) => {
  try {
    const [users] = await pool.query(
      `SELECT id, full_name, email, phone, gender, bio, created_at
       FROM users
       WHERE id != ?
       ORDER BY full_name ASC`,
      [req.userId]
    );

    const result = users.map((u) => ({
      id: u.id,
      full_name: u.full_name,
      email: u.email,
      phone: u.phone,
      gender: u.gender,
      bio: u.bio,
      created_at: u.created_at ? new Date(u.created_at).toISOString() : null,
      is_online: isOnline(u.id),
    }));

    return res.status(200).json(result);
  } catch (err) {
    return res.status(500).json({ message: `Server error: ${err.message}` });
  }
});

// Fetch conversation history between current user and another user.
app.get("/api/messages/:otherUserId", tokenRequired, async (req, res) => {
  const otherUserId = parseInt(req.params.otherUserId, 10);
  if (Number.isNaN(otherUserId)) {
    return res.status(400).json({ message: "Invalid user id" });
  }

  try {
    const [messages] = await pool.query(
      `SELECT id, sender_id, receiver_id, message, created_at
       FROM messages
       WHERE (sender_id = ? AND receiver_id = ?)
          OR (sender_id = ? AND receiver_id = ?)
       ORDER BY created_at ASC`,
      [req.userId, otherUserId, otherUserId, req.userId]
    );

    const result = messages.map((m) => ({
      id: m.id,
      sender_id: m.sender_id,
      receiver_id: m.receiver_id,
      message: m.message,
      created_at: m.created_at ? new Date(m.created_at).toISOString() : null,
    }));

    return res.status(200).json(result);
  } catch (err) {
    return res.status(500).json({ message: `Server error: ${err.message}` });
  }
});

// ---------------------------------------------------------------------------
// SOCKET.IO HANDLERS
// ---------------------------------------------------------------------------

io.use((socket, next) => {
  const userId = verifySocketToken(socket);
  if (!userId) {
    console.log("Socket connection rejected: Invalid Token");
    return next(new Error("Unauthorized"));
  }
  socket.data.userId = userId;
  next();
});

io.on("connection", (socket) => {
  const userId = socket.data.userId;

  addOnline(userId, socket.id);
  socket.join(`user_${userId}`);
  console.log(`User ${userId} connected on socket ${socket.id}`);

  io.emit("user_status", { user_id: userId, status: "online" });

  // Send a message (persist + deliver to both parties).
  socket.on("send_message", async (data = {}) => {
    let senderId;
    try {
      const decoded = jwt.verify(data.token, JWT_SECRET);
      senderId = decoded.user_id;
    } catch (err) {
      socket.emit("error", { message: "Unauthorized token" });
      return;
    }

    const receiverId = data.receiver_id;
    const messageText = (data.message || "").trim();
    if (!receiverId || !messageText) return;

    try {
      const [result] = await pool.query(
        "INSERT INTO messages (sender_id, receiver_id, message) VALUES (?, ?, ?)",
        [senderId, receiverId, messageText]
      );

      const payload = {
        id: result.insertId,
        sender_id: senderId,
        receiver_id: receiverId,
        message: messageText,
        created_at: new Date().toISOString(),
      };

      io.to(`user_${receiverId}`).emit("new_message", payload);
      io.to(`user_${senderId}`).emit("new_message", payload);
    } catch (err) {
      socket.emit("error", { message: `Failed to send message: ${err.message}` });
    }
  });

  // Typing indicator relay.
  socket.on("typing", (data = {}) => {
    let senderId;
    try {
      const decoded = jwt.verify(data.token, JWT_SECRET);
      senderId = decoded.user_id;
    } catch (err) {
      return;
    }

    const receiverId = data.receiver_id;
    const isTyping = Boolean(data.is_typing);

    if (receiverId) {
      io.to(`user_${receiverId}`).emit("user_typing", {
        sender_id: senderId,
        is_typing: isTyping,
      });
    }
  });

  socket.on("disconnect", () => {
    const info = removeOnline(socket.id);
    if (info) {
      console.log(`User ${info.userId} disconnected from socket ${socket.id}`);
      if (info.wentOffline) {
        io.emit("user_status", { user_id: info.userId, status: "offline" });
      }
    }
  });
});

// ---------------------------------------------------------------------------
// START
// ---------------------------------------------------------------------------
(async () => {
  try {
    await initDb();
    server.listen(PORT, "0.0.0.0", () => {
      console.log(`Starting server on port ${PORT}...`);
      console.log(`REST + Socket.IO ready at http://localhost:${PORT}`);
    });
  } catch (err) {
    console.error("Failed to start server:", err.message);
    console.error(
      "Make sure MySQL (XAMPP) is running and the credentials in .env are correct."
    );
    process.exit(1);
  }
})();
</file>

<file path="README.md">
# Real-Time Chat System — Next.js + Node/Express + Socket.IO + MySQL (XAMPP)

A real-time 1-to-1 chat app.

- **Frontend:** Next.js (App Router, TypeScript, Tailwind) in a `src/app` layout with an atomic component structure (atoms / molecules / organisms)
- **Backend:** Node.js + Express + Socket.IO (replaces the old Python/Flask backend)
- **Database:** MySQL, via **XAMPP**
- **Auth:** JWT + bcrypt password hashing. **Registration** collects a full profile (name, email, phone, gender, date of birth, bio); **login** uses **email + password**. The only enforced sign-up rule is that the password and its confirmation match — everything else is stored as entered. No email verification.

The backend keeps the exact same REST + Socket.IO contract the frontend expects, so the two just work together.

```
chat-system/
├── next-frontend/     # Next.js app (UI)
└── node-backend/      # Node + Express + Socket.IO + MySQL API
```

---

## 1. Prerequisites

- **Node.js 18+** (LTS recommended) — <https://nodejs.org>
- **XAMPP** with MySQL running — <https://www.apachefriends.org>

---

## 2. Set up the database (XAMPP)

1. Open the **XAMPP Control Panel** and click **Start** next to **MySQL** (and Apache if you want phpMyAdmin).
2. You already created a database named **`room_rental`** — good. If not, open phpMyAdmin (<http://localhost/phpmyadmin>) and create it.

You do **not** need to create any tables. The backend creates the `users` and `messages` tables automatically the first time it starts.

> XAMPP's MySQL default credentials are user `root` with an **empty password** on port `3306`. The backend is preconfigured for exactly that. If yours differ, edit `node-backend/.env`.

---

## 3. Start the backend

```bash
cd node-backend
npm install
npm start
```

You should see:

```
Initializing database schema...
Database schema initialized successfully.
Starting server on port 8000...
REST + Socket.IO ready at http://localhost:8000
```

The API now runs on **http://localhost:8000**.

> Tip: `npm run dev` uses nodemon to auto-restart on file changes.

---

## 4. Start the frontend

Open a **second terminal**:

```bash
cd next-frontend
npm install
npm run dev
```

Open **http://localhost:3000** in your browser.

The frontend already knows where the backend is via `next-frontend/.env.local`:

```
NEXT_PUBLIC_API_URL=http://localhost:8000
```

---

## 5. Try it out

1. Open <http://localhost:3000> and **Register** a user (e.g. `alice`).
2. Open a **second browser / incognito window**, register another user (e.g. `bob`).
3. Select the other user from the sidebar and start chatting — messages, typing indicators, and online status update in real time.

---

## Configuration (`node-backend/.env`)

| Variable      | Default        | Notes                                   |
| ------------- | -------------- | --------------------------------------- |
| `PORT`        | `8000`         | Backend port (matches `.env.local`)     |
| `DB_HOST`     | `127.0.0.1`    | XAMPP MySQL host                        |
| `DB_PORT`     | `3306`         | XAMPP MySQL port                        |
| `DB_USER`     | `root`         | XAMPP default user                      |
| `DB_PASSWORD` | *(empty)*      | XAMPP default is no password            |
| `DB_NAME`     | `room_rental`  | Your database                           |
| `JWT_SECRET`  | *(preset)*     | Change this for production              |

If you change `PORT`, also update `next-frontend/.env.local`.

---

## Troubleshooting

- **`ECONNREFUSED 127.0.0.1:3306`** → MySQL isn't running. Start it in the XAMPP Control Panel.
- **`Access denied for user 'root'`** → You set a MySQL password. Put it in `DB_PASSWORD` in `node-backend/.env`.
- **Frontend can't reach backend** → Make sure the backend is running on port 8000 and `next-frontend/.env.local` matches. Restart `npm run dev` after editing `.env.local`.
- **Port 8000 already in use** → Change `PORT` in `node-backend/.env` and `NEXT_PUBLIC_API_URL` in `next-frontend/.env.local`.

---

## What changed from the original

- The `python-flask-api/` folder was replaced by `node-backend/` (Express + Socket.IO).
- The database moved from TiDB Cloud to local **MySQL (XAMPP)**, database `room_rental`.
- Passwords are hashed with **bcrypt** (Node). Because the hashing scheme differs from the old Flask/Werkzeug hashes, start with a fresh database and register users again.
- The frontend is unchanged.

## API reference

REST:
- `POST /api/register` — `{ username, password }`
- `POST /api/login` — `{ username, password }` → `{ token, user }`
- `GET /api/users` — *(Bearer token)* → list of other users + online status
- `GET /api/messages/:otherUserId` — *(Bearer token)* → conversation history

Socket.IO (auth via `{ token }` handshake):
- Client → server: `send_message` `{ token, receiver_id, message }`, `typing` `{ token, receiver_id, is_typing }`
- Server → client: `new_message`, `user_status` `{ user_id, status }`, `user_typing` `{ sender_id, is_typing }`, `error`
</file>

<file path="WHATS_NEW.md">
# What changed

This update reworks the **chat authentication** so users register and log in
successfully, and refactors the frontend into a clean, atomic `src/app` layout.

## Auth behaviour

- **Register** now collects a full profile: full name, email, phone, gender,
  date of birth, bio, password, and confirm password.
- The **only** enforced client-side rule is that **password === confirm password**.
  Everything else is saved exactly as the user entered it. Empty optional fields
  are stored as `NULL`. There is **no email verification**.
- **Login** now uses **email + password** (username is gone).
- On successful registration the user row is created immediately and the user is
  redirected to the login page.

## Backend (`node-backend/`)

- **`db.js`** — the `users` table schema was expanded:
  `id, full_name, email (UNIQUE), phone, gender, date_of_birth, bio,
  password_hash, created_at`.
- **`server.js`**
  - `POST /api/register` accepts and stores all profile fields; requires only
    `email` + `password` structurally; rejects duplicate emails.
  - `POST /api/login` authenticates by `email`.
  - JWT payload and `GET /api/users` now use `full_name` / `email`.

> If you already had an old `users` table, drop it once so the new schema is
> created: in phpMyAdmin run `DROP TABLE messages; DROP TABLE users;` then
> restart the backend (tables are recreated automatically).

## Frontend (`next-frontend/`)

Moved to a **`src/app`** structure with an atomic component hierarchy.

```
src/
├── app/                      # App Router pages (thin — they just render organisms)
│   └── chat/
│       ├── page.tsx          -> <ChatApp />
│       ├── login/page.tsx    -> <LoginForm />
│       └── register/page.tsx -> <RegisterForm />
├── components/
│   ├── atoms/                # Button, Spinner, Field (Input/Textarea/Select/Label),
│   │                         # Alert, Presence (Avatar/OnlineDot/IconBadge)
│   ├── molecules/            # FormField, AuthCard/AuthHeader, chat rows/bubbles/input
│   └── organisms/
│       ├── auth/             # AuthShell, LoginForm, RegisterForm
│       └── chat/             # ChatApp, ChatSidebar, ChatWindow
├── hooks/                    # useAuth, useChatSocket
└── lib/                      # api (typed client), types, utils
```

The `@/*` path alias now points at `./src/*` (see `tsconfig.json`).

## Run it

```bash
# 1) backend
cd node-backend
npm install
npm run dev            # http://localhost:8000  (needs XAMPP MySQL running)

# 2) frontend
cd ../next-frontend
npm install
npm run dev            # http://localhost:3000
```

Then open <http://localhost:3000/chat/register>, create an account, and log in
at <http://localhost:3000/chat/login>.
</file>

