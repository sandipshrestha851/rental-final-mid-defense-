# ---- Server ----
PORT=8000
CLIENT_URL=http://localhost:3000

# ---- MySQL (XAMPP defaults) ----
# XAMPP MySQL runs on localhost:3306 with user "root" and an empty password by default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=room_rental

# ---- Auth ----
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-string
